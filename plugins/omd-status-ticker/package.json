{
  "name": "@dbydd/omd-status-ticker",
  "version": "0.1.0",
  "description": "Two-line news-ticker band at the top of the dsh web frame: child agents on one line, background jobs on the other, read from dsh-resource://agents/<sessionId>",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbydd/ohMyDsBot.git",
    "directory": "plugins/omd-status-ticker"
  }
}
