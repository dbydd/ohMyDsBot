{
  "name": "@dbydd/omd-workbench",
  "version": "0.1.0",
  "description": "Workbench chrome for the dsh web UI: our own top bar (session title, new session, sidebar toggle) above the shipped frame",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbydd/ohMyDsBot.git",
    "directory": "plugins/omd-workbench"
  }
}
