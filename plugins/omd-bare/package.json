{
  "name": "@dbydd/omd-bare",
  "version": "0.1.0",
  "description": "Bare shell for the dsh web UI: zeroes the sidebar and right column and lets the conversation own the frame",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbydd/ohMyDsBot.git",
    "directory": "plugins/omd-bare"
  }
}
