    "omd-compute": "*",
    "omd-onlyne": "*",
    "omd-sandbox-vm": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/schemastery": "*",
    "@onlyne/lib": "^3.2.0",
    "omd-compute": "*",
    "@types/node": "^22.10.0"
  }
